# Copy to .env and fill in. bootstrap_db.py will generate one for you.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# MySQL — local only
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=j1spa_app
DB_PASSWORD=
OPS_DB=j1spa_ops
DW_DB=j1spa_dw

# Path to the folder that contains mysql.exe / mysqldump.exe
MYSQL_BIN=C:/Program Files/MySQL/MySQL Server 8.0/bin

# Background jobs
SCHEDULER_ENABLED=true
INCREMENTAL_INTERVAL_MIN=15
RULES_INTERVAL_MIN=30
BACKUP_HOUR=23
BACKUP_MINUTE=30
BACKUP_KEEP=7

# Server
HOST=127.0.0.1
PORT=5000
